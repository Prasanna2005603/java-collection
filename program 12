import java.util.*;
public class HappyNumber {
    public boolean isHappy(int n) {
        HashSet<Integer> seen = new HashSet<>();
        while (n != 1) {
            if (!seen.add(n)) return false;
            int sum = 0;
            while (n > 0) {
                int d = n % 10;
                sum += d * d;
                n /= 10;
            }
            n = sum;
        }
        return true;
    }
    public static void main(String[] args) {
        System.out.println("Input:  19");
        System.out.println("Output: " + new HappyNumber().isHappy(19));
    }
}
