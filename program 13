import java.util.*;
public class LeadersInArray {
    public ArrayList<Integer> findLeaders(ArrayList<Integer> list) {
        ArrayList<Integer> result = new ArrayList<>();
        int n = list.size();
        int maxRight = list.get(n - 1);
        result.add(maxRight);
        for (int i = n - 2; i >= 0; i--) {
            if (list.get(i) > maxRight) {
                maxRight = list.get(i);
                result.add(maxRight);
            }
        }
        Collections.reverse(result);
        return result;
    }
    public static void main(String[] args) {
        ArrayList<Integer> list = new ArrayList<>(Arrays.asList(16,17,4,3,5,2));
        System.out.println("Input:  " + list);
        System.out.println("Output: " + new LeadersInArray().findLeaders(list));
    }
}
