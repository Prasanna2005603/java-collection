import java.util.*;
public class CommonUniqueElements {
    public List<Integer> intersection(int[] arr1, int[] arr2) {
        HashSet<Integer> set = new HashSet<>();
        for (int n : arr1) set.add(n);
        HashSet<Integer> result = new HashSet<>();
        for (int n : arr2) {
            if (set.contains(n)) result.add(n);
        }
        return new ArrayList<>(result);
    }
    public static void main(String[] args) {
        int[] arr1 = {1, 2, 2, 3};
        int[] arr2 = {2, 2, 4};
        System.out.println("Input:  " + Arrays.toString(arr1) + ", " + Arrays.toString(arr2));
        System.out.println("Output: " + new CommonUniqueElements().intersection(arr1, arr2));
    }
}
